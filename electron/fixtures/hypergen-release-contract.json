{
  "version": "0.1.0-preview.1",
  "tag": "v0.1.0-preview.1",
  "workflow": ".github/workflows/release.yml",
  "platforms": {
    "windows": {
      "runner": "windows-latest",
      "arch": "x64",
      "packages": [
        "HyperGen-0.1.0-preview.1-Setup.exe",
        "HyperGen-0.1.0-preview.1-Setup.exe.blockmap",
        "latest.yml"
      ],
      "runtimePrefix": "python-embed-win32"
    },
    "linux": {
      "runner": "ubuntu-latest",
      "arch": "x64",
      "packages": ["HyperGen-x86_64.AppImage", "HyperGen-amd64.deb", "latest-linux.yml"],
      "runtimePrefix": "python-embed-linux-x64"
    },
    "macos": {
      "runnerPattern": "^macos-.*",
      "arch": "arm64",
      "packages": [
        "HyperGen-0.1.0-preview.1-arm64.dmg",
        "HyperGen-0.1.0-preview.1-arm64-mac.zip",
        "HyperGen-0.1.0-preview.1-arm64-mac.zip.blockmap",
        "latest-mac.yml"
      ]
    }
  },
  "sharedArtifacts": ["python-deps-hash.txt", "SHA256SUMS"]
}
